# boris.gb 2026-10-30 00:29 - TrustPanel HTTPS on PANEL_PORT only
# boris.gb 2026-11-18 18:36 - Let's Encrypt certificate for the server IP (shortlived profile, ~6 days, Caddy renews it itself)
# instead of Caddy's internal CA: browsers trust the panel without a warning
{
	# HTTPS only, Caddy admin API disabled; no HTTP→HTTPS redirect: Caddy opens :80 only for a few seconds
	# while Let's Encrypt validates the certificate (http-01), so :80 may be shared with another Caddy doing the same
	admin off
	auto_https disable_redirects
}

https://{$PANEL_HOST}:{$PANEL_PORT:15443} {
	# boris.gb 2026-11-18 18:36 - certificate via ACME http-01 on :80 (open :80/tcp in the firewall)
	tls {
		issuer acme {
			profile shortlived
			# port 443 is TrustTunnel's: no tls-alpn-01
			disable_tlsalpn_challenge
		}
		# no port 80 at all: replace this block with "tls internal" (Caddy's local CA, the browser warns once;
		# check the fingerprint on first login)
	}

	encode gzip
	reverse_proxy 127.0.0.1:{$PANEL_BIND_PORT:8081}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		# boris.gb 2026-10-30 01:07 - form-action also allows https://t.me: "Connect Telegram" posts a form that redirects to the bot,
		# and browsers apply form-action to that redirect (with 'self' only the button silently did nothing)
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'; form-action 'self' https://t.me"
		-Server
	}
}
