# boris.gb 2026-10-30 00:29 - example TrustPanel settings; the working file is /opt/trust-panel/.env (mode 600), never commit it

# --- access ---
# public IP (or domain) of the server for the panel URL
PANEL_HOST=203.0.113.10
# panel HTTPS port; after a change: ufw allow <port>/tcp and docker compose up -d --force-recreate caddy panel
PANEL_PORT=15443
# internal port of the panel behind Caddy (127.0.0.1 only)
PANEL_BIND_PORT=8081
ADMIN_USER=admin
# ./init-admin.sh fills ADMIN_PASSWORD_HASH and TOTP_SECRET
ADMIN_PASSWORD_HASH=
TOTP_SECRET=
# 32+ random bytes: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Fernet key for client passwords: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# false — only for local debugging without HTTPS
COOKIE_SECURE=true
# interface language by default (file panel/app/locales/<code>.json)
DEFAULT_LANG=en

# --- TrustTunnel ---
# endpoint directory (vpn.toml, hosts.toml, credentials.toml, trusttunnel_endpoint) and its systemd service
TT_DIR=/opt/trusttunnel
TT_SERVICE=trusttunnel
# metrics listener of the endpoint: [metrics] address = "127.0.0.1:1987", per_client_metrics = true in vpn.toml
TT_METRICS=http://127.0.0.1:1987
# server address written into client configs: ip, ip:port, domain or domain:port (default — PUBLIC_HOST)
PUBLIC_HOST=203.0.113.10
TT_ADDRESS=
# server name shown in the TrustTunnel app
TT_NAME=TrustTunnel
# DNS upstreams in client configs, comma separated; empty — the endpoint default
CLIENT_DNS=

# --- collection ---
# boris.gb 2026-11-01 00:21 - panel time zone (IANA name, e.g. Europe/Berlin): day/month boundaries, archive, schedules; default UTC
TZ=UTC
POLL_INTERVAL=30
ONLINE_WINDOW=180
RETENTION_RAW_DAYS=30
RETENTION_MIN_DAYS=7
RETENTION_EVENTS_DAYS=365

# --- alerts ---
ALERT_SHARED_CHANGES=6
ALERT_SHARED_WINDOW_MIN=30
ALERT_SPIKE_FACTOR=5
ALERT_SPIKE_MIN_BYTES=1073741824

# --- client portal and notifications; empty — channel disabled ---
# bot token from @BotFather (keep it secret)
TELEGRAM_BOT_TOKEN=
# mail: 587 + STARTTLS or 465 + SMTP_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
